{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kalkulator IKM",
  "version": "1.0.0",
  "identifier": "id.go.kpu.bitung.ikm",
  "build": { "frontendDist": "../src" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "Kalkulator IKM / SKM", "width": 1280, "height": 820, "minWidth": 900, "minHeight": 600, "dragDropEnabled": false }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png","icons/128x128.png","icons/128x128@2x.png","icons/icon.icns","icons/icon.ico"],
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
